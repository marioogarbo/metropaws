# MetroPaws backend — configuration reference.
#
# This file is committed and contains NO real secrets. Copy it when creating a
# new environment file; never put live values back into it.
#
#   .env.dev    APP_ENV=dev (the default) — the DEV Supabase project
#   .env.prod   APP_ENV=prod              — the LIVE database
#   .env.local  personal overrides, read first, beats both. Not committed.
#
# Running locally with no APP_ENV set targets DEV. In Docker and on Render
# these are real environment variables and no file is read — see config.py.
#
# NOTE: every variable the deployed service needs must also be listed in
# deploy.ps1's $renderEnvKeys allowlist, or it is dropped on deploy.

# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/postgres
SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── URLs ────────────────────────────────────────────────────────────────────
# BASE_URL is this API's own public address; it builds the file URLs handed to
# clients and the PayMongo return pages. Override it in .env.local when running
# on your own machine (http://localhost:8000).
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=https://metropaws.ph

# ── Uploads ─────────────────────────────────────────────────────────────────
# Supabase Storage is durable; the local uploads/ fallback is NOT durable on
# Render's free tier (wiped on redeploy / spin-down). Configure Supabase in
# any deployed environment.
UPLOAD_DIR=uploads
MAX_FILE_BYTES=8388608
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-server-side-only
SUPABASE_BUCKET=uploads

# ── Email ───────────────────────────────────────────────────────────────────
# ZeptoMail's HTTP API is required in production — Render's free tier blocks
# outbound SMTP ports (25/465/587). SMTP is the local-dev fallback and is used
# only while ZEPTOMAIL_TOKEN is unset.
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=MetroPaws

# ── Seeding (seed.py only) ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@metropaws.ph
SEED_ADMIN_PASSWORD=set-before-running-seed.py
# Sample clinic logins are created only when this is set — leave it blank
# outside local development.
SEED_CLINIC_PASSWORD=

# ── Payments (PayMongo) ─────────────────────────────────────────────────────
# Test keys (sk_test_…) for dev, live keys for prod. The redirect URLs must be
# http(s); they default to BASE_URL/payments/return/... when unset.
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxx
# PAYMONGO_SUCCESS_REDIRECT=
# PAYMONGO_FAILURE_REDIRECT=

# ── Business rules (code defaults shown) ────────────────────────────────────
# Pack Discount on/off and percent are admin-controlled at runtime from the
# website Settings page; this is only the fresh-install fallback.
# PACK_DISCOUNT_PERCENT=15
# PACK_DISCOUNT_MAX_PLAN_PETS=3
# RENEWAL_WINDOW_DAYS=30
# REIMBURSEMENT_MAX_CLAIM_PHP=20000
# REIMBURSEMENT_MAX_PER_DAY=20
# REIMBURSEMENT_GROOMING_COOLDOWN_DAYS=90
# REIMBURSEMENT_PROVIDER_MAX_FUTURE_DAYS=60
# REIMBURSEMENT_ENFORCE_DUAL_CONTROL=false

# ── Payment receipt PDF — seller / tax identity ─────────────────────────────
# Lines with no value are omitted from the PDF; nothing is invented.
INVOICE_BUSINESS_NAME=MetroPaws Wellness Club Philippines, Inc.
# '|' splits the address into separate display lines (street | city + ZIP).
INVOICE_BUSINESS_ADDRESS=street address | city and ZIP
INVOICE_BUSINESS_TIN=
INVOICE_BUSINESS_EMAIL=
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_WEBSITE=metropaws.ph
INVOICE_BUSINESS_REG_LINE=
# Use OFFICIAL RECEIPT only with a real BIR-accredited OR series.
# INVOICE_DOC_TITLE=PAYMENT RECEIPT
# 0 hides tax lines; 12 shows a VAT-inclusive breakdown.
# INVOICE_VAT_PERCENT=0

# ── Deployment credential (read by deploy.ps1, never sent to the service) ───
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxx
